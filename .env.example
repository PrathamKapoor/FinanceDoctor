# Financial Doctor environment configuration.
# Copy to `.env` and adjust. Never commit `.env`.

# Application
APP_NAME="Financial Doctor"
ENVIRONMENT="development"

# CORS: explicit comma-separated frontend origins (no wildcards with credentials)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# NOTE: the frontend API base is a build-time Vite variable, not read here:
#   VITE_API_BASE_URL=""  (empty = same origin; dev uses the Vite proxy)

# SQLite database URL. Use sqlite:///:memory: for ephemeral/tests.
DATABASE_URL="sqlite:///./data/financial_doctor.db"

# Razorpay configuration
# Mode: "stub" (default, no network calls) or "live" (real API calls)
RAZORPAY_MODE="stub"
# Live mode credentials (required only when RAZORPAY_MODE=live)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret for signature verification (set in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET="test_webhook_secret"

# MiniMax consultation reasoning (Stage 7A read-only Q&A)
# Empty key = deterministic stub (default, no network calls)
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.chat/v1"
MINIMAX_M27_MODEL="MiniMax-M2.7"
MINIMAX_M3_MODEL="MiniMax-M3"
MINIMAX_GROUP_ID=""

# MiniMax Speech 2.8 TTS (Stage 7A spoken answers)
# Provider: "stub" (default, local placeholder audio) or "minimax" (live TTS).
# NOTE: no public MiniMax speech-to-text endpoint is available, so voice
# questions are typed; only spoken answers use Speech 2.8.
SPEECH_PROVIDER="stub"
SPEECH_MODEL="speech-2.8-turbo"
SPEECH_VOICE_ID="English_expressive_narrator"